diff --git a/supabase/07_donation_deletion.sql b/supabase/07_donation_deletion.sql
new file mode 100644
index 0000000..fbea10a
--- /dev/null
+++ b/supabase/07_donation_deletion.sql
@@ -0,0 +1,83 @@
+-- ---------- deleted donations (audit trail, PRIVATE — admin/committee only) ----------
+-- Donor history is never hard-deleted from the app's point of view: removing
+-- a donation moves it here with a required reason and who removed it, via
+-- delete_donation_with_reason() below. The row is kept even after the
+-- source donation/festival is gone, so festival_id has no FK/cascade.
+create table if not exists deleted_donations (
+  id uuid primary key default gen_random_uuid(),
+  donation_id uuid,
+  festival_id uuid,
+  donor_name text not null,
+  amount numeric(12,2) not null,
+  donation_date date not null,
+  payment_method text,
+  collector text,
+  notes text,
+  reason text not null,
+  deleted_by_name text not null,
+  deleted_by uuid references profiles(id),
+  deleted_at timestamptz not null default now()
+);
+
+create index if not exists idx_deleted_donations_festival on deleted_donations(festival_id, deleted_at desc);
+
+alter table deleted_donations enable row level security;
+
+-- Only committee/admin can ever see this list. There is deliberately no
+-- insert/update/delete policy for regular roles — the only way rows get
+-- created is through the SECURITY DEFINER function below, and rows are
+-- never edited or removed once written (it's an audit trail).
+create policy "deleted_donations: committee/admin read" on deleted_donations for select
+  using (is_committee_or_admin());
+
+-- ---------- delete_donation_with_reason() ----------
+-- Moves a donation into deleted_donations and removes it from the live
+-- donations table, atomically, requiring both a reason and the name of
+-- whoever is deleting it. Committee members and admins may both call this
+-- (the existing "donations: admin delete" RLS policy stays in place as a
+-- separate, admin-only escape hatch for direct table access, e.g. via the
+-- SQL editor — the app itself always goes through this function).
+create or replace function delete_donation_with_reason(
+  p_donation_id uuid,
+  p_reason text,
+  p_deleted_by_name text
+)
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_row donations%rowtype;
+begin
+  if not is_committee_or_admin() then
+    raise exception 'Not authorized to delete donations.';
+  end if;
+
+  if p_reason is null or length(trim(p_reason)) = 0 then
+    raise exception 'A reason is required to delete a donation.';
+  end if;
+
+  if p_deleted_by_name is null or length(trim(p_deleted_by_name)) = 0 then
+    raise exception 'The name of the person deleting this donation is required.';
+  end if;
+
+  select * into v_row from donations where id = p_donation_id;
+  if not found then
+    raise exception 'Donation not found (it may have already been deleted).';
+  end if;
+
+  insert into deleted_donations (
+    donation_id, festival_id, donor_name, amount, donation_date,
+    payment_method, collector, notes, reason, deleted_by_name, deleted_by
+  ) values (
+    v_row.id, v_row.festival_id, v_row.donor_name, v_row.amount, v_row.donation_date,
+    v_row.payment_method, v_row.collector, v_row.notes,
+    trim(p_reason), trim(p_deleted_by_name), auth.uid()
+  );
+
+  delete from donations where id = p_donation_id;
+end;
+$$;
+
+grant execute on function delete_donation_with_reason(uuid, text, text) to authenticated;
