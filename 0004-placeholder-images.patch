From c7d0cfd032ce98eb63696cc3174dc971cbe03da5 Mon Sep 17 00:00:00 2001
From: Vamsi <vamsi@example.com>
Date: Sun, 30 Aug 2026 13:17:00 +0000
Subject: [PATCH] Support external placeholder images + fill test seed with
 real images

- api.js / adminApi.js: publicImageUrl()/publicUrl() now pass an
  already-absolute https:// value straight through instead of always
  treating it as a path inside the gallery storage bucket. Real
  uploads still work exactly as before (unaffected).
- 14_full_test_seed.sql: every image/photo/QR field is now filled
  with a placeholder (picsum.photos for scenery/prizes/albums,
  dicebear for people avatars and QR-looking codes), and the photos
  table now gets 2-3 real placeholder photos per album.
---
 src/services/adminApi.js       |   1 +
 src/services/api.js            |   1 +
 supabase/14_full_test_seed.sql | 157 +++++++++++++++++++++------------
 3 files changed, 101 insertions(+), 58 deletions(-)

diff --git a/src/services/adminApi.js b/src/services/adminApi.js
index 49defbb..a97db66 100644
--- a/src/services/adminApi.js
+++ b/src/services/adminApi.js
@@ -362,6 +362,7 @@ export async function uploadImage(file, path) {
 
 export function publicUrl(path) {
   if (!path) return null;
+  if (/^https?:\/\//i.test(path)) return path; // already a full URL (e.g. test/placeholder image)
   const { data } = supabase.storage.from('gallery').getPublicUrl(path);
   return data?.publicUrl ?? null;
 }
diff --git a/src/services/api.js b/src/services/api.js
index 52cc574..8c7f161 100644
--- a/src/services/api.js
+++ b/src/services/api.js
@@ -32,6 +32,7 @@ function bilingual(en, te, sourceLang) {
 // ---------- storage helpers ----------
 export function publicImageUrl(path) {
   if (!path) return null;
+  if (/^https?:\/\//i.test(path)) return path; // already a full URL (e.g. test/placeholder image)
   if (!isSupabaseConfigured) return null;
   const { data } = supabase.storage.from('gallery').getPublicUrl(path);
   return data?.publicUrl ?? null;
diff --git a/supabase/14_full_test_seed.sql b/supabase/14_full_test_seed.sql
index 59acf5f..4d99525 100644
--- a/supabase/14_full_test_seed.sql
+++ b/supabase/14_full_test_seed.sql
@@ -1,20 +1,23 @@
 -- ============================================================
--- Devi Youth — full test-data seed
+-- Devi Youth — full test-data seed (with placeholder images)
 --
 -- Run AFTER 01_schema.sql, 02_policies.sql, 03_storage.sql,
 -- 04_seed.sql and 13_donation_qr.sql (Supabase SQL editor — runs as
 -- postgres, bypasses RLS). Safe to re-run: it clears and re-inserts
 -- the 2026 festival's rows each time.
 --
--- This fills EVERY plain text/number/date column on every table so
--- each page in the app has something to show for every field. It
--- deliberately leaves *_url / *_photo_url columns blank — Postgres
--- can't upload real files into the `gallery` storage bucket, and
--- publicImageUrl() always treats those columns as a path inside that
--- bucket, so a plain external URL (picsum, etc.) would not resolve.
--- Upload a real photo for each of those from the admin screens
--- listed at the bottom of this file — that's the only way to see the
--- photo/QR blocks fully populated.
+-- This fills EVERY column on every table, including the *_url /
+-- *_photo_url columns, using free placeholder images
+-- (picsum.photos and api.dicebear.com) so every page has something
+-- to look at for testing. This relies on a small app-code change —
+-- publicImageUrl()/publicUrl() now pass an already-absolute
+-- "https://..." value straight through instead of treating it as a
+-- path inside the `gallery` storage bucket — so make sure that
+-- change (src/services/api.js and src/services/adminApi.js) is
+-- deployed before you run this, or these images just won't resolve.
+--
+-- These are placeholders for layout/testing only — swap them for
+-- real photos before going live with real committee members.
 -- ============================================================
 
